# OpenConnect GUI journal-aware fork of vpnc-scripts
# ce9e961bd0f6b867e1c7c35f78f6fb973f6ff101.
# The original do_connect/do_disconnect orchestration below is executed.
# Mutation functions send typed requests to the owning journal process, which
# acknowledges only after native observation and durable per-key persistence.
# No hooks, backup files, global resolver rewrites or environment sourcing.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
case "$1" in
  ocgui-lifecycle) shift ;;
  ocgui-ip) shift; exec /usr/sbin/ip "$@" ;;
  ocgui-ip-sbin) shift; exec /sbin/ip "$@" ;;
  ocgui-ifconfig) shift; exec /sbin/ifconfig "$@" ;;
  ocgui-route) shift; exec /sbin/route "$@" ;;
  ocgui-resolvectl) shift; exec /usr/bin/resolvectl "$@" ;;
  ocgui-resolvconf) shift; exec /sbin/resolvconf "$@" ;;
  ocgui-scutil) shift; exec /usr/sbin/scutil "$@" ;;
  ocgui-addrgen)
    shift
    [ "$#" -eq 2 ] || exit 64
    case "$1" in ""|*[!a-zA-Z0-9_.:-]*|-*) exit 64 ;; esac
    case "$2" in 0|1|2|3) ;; *) exit 64 ;; esac
    printf '%s\n' "$2" > "/proc/sys/net/ipv6/conf/$1/addr_gen_mode"
    exit "$?"
    ;;
  *) echo "vpnc-script requires the journaled OpenConnect GUI adapter" >&2; exit 64 ;;
esac

# The parent supplies normalized, preflighted routes (including /1 defaults and
# connected-prefix overrides). Shell values are never interpreted as commands.
set -eu
# Retain upstream resolver backend selection, bounded by the parent's lifecycle
# deadline. Disconnect uses the recorded backend even if system policy changed.
detect_resolved_nss_resolve() {
  grep '^hosts:' /etc/nsswitch.conf 2>/dev/null | grep -w resolve >/dev/null 2>&1
}
detect_resolved_nss_dns() {
  grep '^hosts:' /etc/nsswitch.conf 2>/dev/null | grep -w dns >/dev/null 2>&1 &&
    readlink /etc/resolv.conf | grep -E '(^|^\.\.)/(run/systemd/resolve/(stub-resolv|resolv)\.conf|usr/lib/systemd/resolv\.conf)$' >/dev/null 2>&1
}
detect_resolved_manager() {
  { detect_resolved_nss_resolve || detect_resolved_nss_dns; } &&
    /usr/bin/resolvectl status >/dev/null 2>&1
}
if [ "$reason" != disconnect ] && [ "$OCGUI_RESOLVER" != none ]; then
  if [ "$(uname -s)" = Darwin ]; then
    selected_resolver=darwin
  elif [ -x /usr/bin/resolvectl ] && detect_resolved_manager; then
    selected_resolver=resolved
  elif [ -x /sbin/resolvconf ] && [ "$(basename "$(readlink /sbin/resolvconf 2>/dev/null)" 2>/dev/null)" != resolvectl ]; then
    selected_resolver=resolvconf
  else
    echo "Active resolver cannot be journaled by this installation" >&2
    exit 69
  fi
  [ "$selected_resolver" = "$OCGUI_RESOLVER" ] || exit 75
fi
case "$OCGUI_RESOLVER" in
  resolved) MODIFYRESOLVCONF=modify_resolved_manager; RESTORERESOLVCONF=restore_resolved_manager ;;
  resolvconf) MODIFYRESOLVCONF=modify_resolvconf_manager; RESTORERESOLVCONF=restore_resolvconf_manager ;;
  darwin) MODIFYRESOLVCONF=modify_resolvconf_darwin; RESTORERESOLVCONF=restore_resolvconf_darwin ;;
  none) MODIFYRESOLVCONF=modify_resolvconf_none; RESTORERESOLVCONF=restore_resolvconf_none ;;
  *) exit 64 ;;
esac

ocgui_operation() {
  printf '%s %s\n' "$1" "${2:--}"
  IFS= read -r acknowledgement || exit 70
  [ "$acknowledgement" = ok ] || exit 70
}
set_vpngateway_route() { ocgui_operation gateway; }
del_vpngateway_route() { ocgui_operation gateway; }
do_ifconfig() { ocgui_operation interface; }
undo_ifconfig() { ocgui_operation interface; }
set_ipv4_exclude_route() { ocgui_operation route "$1/$3"; }
del_ipv4_exclude_route() { ocgui_operation route "$1/$3"; }
set_ipv6_exclude_route() { ocgui_operation route "$1/$2"; }
del_ipv6_exclude_route() { ocgui_operation route "$1/$2"; }
set_ipv4_network_route() { ocgui_operation route "$1/$3"; }
del_ipv4_network_route() { ocgui_operation route "$1/$3"; }
set_ipv6_network_route() { ocgui_operation route "$1/$2"; }
del_ipv6_network_route() { ocgui_operation route "$1/$2"; }
# Full tunnels arrive as explicit paired /1s, never an unjournaled /0 rewrite.
set_ipv4_default_route() { ocgui_operation default4; }
reset_ipv4_default_route() { ocgui_operation default4; }
set_ipv6_default_route() { ocgui_operation default6; }
reset_ipv6_default_route() { ocgui_operation default6; }
modify_resolved_manager() { ocgui_operation resolved; }
restore_resolved_manager() { ocgui_operation resolved; }
modify_resolvconf_manager() { ocgui_operation resolvconf; }
restore_resolvconf_manager() { ocgui_operation resolvconf; }
modify_resolvconf_darwin() { ocgui_operation darwin; }
restore_resolvconf_darwin() { ocgui_operation darwin; }
modify_resolvconf_none() { exit 64; }
restore_resolvconf_none() { exit 64; }

do_connect() {
	if [ -n "$CISCO_BANNER" ]; then
		echo "Connect Banner:"
		echo "$CISCO_BANNER" | while read LINE ; do echo "|" "$LINE" ; done
		echo
	fi

	case "$VPNGATEWAY" in
		127.*|::1) ;; # localhost (probably proxy)
		*) set_vpngateway_route ;;
	esac
	# Exclusions precede interface routes so the transport remains reachable.
	if [ -n "$CISCO_SPLIT_EXC" ]; then
		i=0
		while [ $i -lt $CISCO_SPLIT_EXC ] ; do
			eval NETWORK="\${CISCO_SPLIT_EXC_${i}_ADDR}"
			eval NETMASK="\${CISCO_SPLIT_EXC_${i}_MASK}"
			eval NETMASKLEN="\${CISCO_SPLIT_EXC_${i}_MASKLEN}"
			set_ipv4_exclude_route "$NETWORK" "$NETMASK" "$NETMASKLEN"
			i=`expr $i + 1`
		done
	fi
	if [ -n "$CISCO_IPV6_SPLIT_EXC" ]; then
		# untested
		i=0
		while [ $i -lt $CISCO_IPV6_SPLIT_EXC ] ; do
			eval NETWORK="\${CISCO_IPV6_SPLIT_EXC_${i}_ADDR}"
			eval NETMASKLEN="\${CISCO_IPV6_SPLIT_EXC_${i}_MASKLEN}"
			set_ipv6_exclude_route "$NETWORK" "$NETMASKLEN"
			i=`expr $i + 1`
		done
	fi
	do_ifconfig
	if [ -n "$CISCO_SPLIT_INC" ]; then
		i=0
		while [ $i -lt $CISCO_SPLIT_INC ] ; do
			eval NETWORK="\${CISCO_SPLIT_INC_${i}_ADDR}"
			eval NETMASK="\${CISCO_SPLIT_INC_${i}_MASK}"
			eval NETMASKLEN="\${CISCO_SPLIT_INC_${i}_MASKLEN}"
			if [ "$NETMASKLEN" -ne 0 ]; then
				set_ipv4_network_route "$NETWORK" "$NETMASK" "$NETMASKLEN" "$TUNDEV"
			else
				set_ipv4_default_route
			fi
			i=`expr $i + 1`
		done
	elif [ -n "$INTERNAL_IP4_ADDRESS" ]; then
		set_ipv4_default_route
	fi
	if [ -n "$CISCO_IPV6_SPLIT_INC" ]; then
		i=0
		while [ $i -lt $CISCO_IPV6_SPLIT_INC ] ; do
			eval NETWORK="\${CISCO_IPV6_SPLIT_INC_${i}_ADDR}"
			eval NETMASKLEN="\${CISCO_IPV6_SPLIT_INC_${i}_MASKLEN}"
			if [ $NETMASKLEN -eq 0 ]; then
				set_ipv6_default_route
			else
				set_ipv6_network_route "$NETWORK" "$NETMASKLEN" "$TUNDEV"
			fi
			i=`expr $i + 1`
		done
	elif [ -n "$INTERNAL_IP6_NETMASK" -o -n "$INTERNAL_IP6_ADDRESS" ]; then
		set_ipv6_default_route
	fi

	if [ -n "$INTERNAL_IP4_DNS$INTERNAL_IP6_DNS" ]; then
		$MODIFYRESOLVCONF
	fi
}

do_disconnect() {
	if [ -n "$CISCO_SPLIT_INC" ]; then
		i=0
		while [ $i -lt $CISCO_SPLIT_INC ] ; do
			eval NETWORK="\${CISCO_SPLIT_INC_${i}_ADDR}"
			eval NETMASK="\${CISCO_SPLIT_INC_${i}_MASK}"
			eval NETMASKLEN="\${CISCO_SPLIT_INC_${i}_MASKLEN}"
			if [ "$NETMASKLEN" -ne 0 ]; then
				# The bridge restores only a still-owned applied value.
				del_ipv4_network_route "$NETWORK" "$NETMASK" "$NETMASKLEN" "$TUNDEV"
			else
				reset_ipv4_default_route
			fi
			i=`expr $i + 1`
		done
	else
		reset_ipv4_default_route
	fi
	if [ -n "$CISCO_SPLIT_EXC" ]; then
		i=0
		while [ $i -lt $CISCO_SPLIT_EXC ] ; do
			eval NETWORK="\${CISCO_SPLIT_EXC_${i}_ADDR}"
			eval NETMASK="\${CISCO_SPLIT_EXC_${i}_MASK}"
			eval NETMASKLEN="\${CISCO_SPLIT_EXC_${i}_MASKLEN}"
			del_ipv4_exclude_route "$NETWORK" "$NETMASK" "$NETMASKLEN"
			i=`expr $i + 1`
		done
	fi
	if [ -n "$CISCO_IPV6_SPLIT_EXC" ]; then
		# untested
		i=0
		while [ $i -lt $CISCO_IPV6_SPLIT_EXC ] ; do
			eval NETWORK="\${CISCO_IPV6_SPLIT_EXC_${i}_ADDR}"
			eval NETMASKLEN="\${CISCO_IPV6_SPLIT_EXC_${i}_MASKLEN}"
			del_ipv6_exclude_route "$NETWORK" "$NETMASKLEN"
			i=`expr $i + 1`
		done
	fi
	if [ -n "$CISCO_IPV6_SPLIT_INC" ]; then
		i=0
		while [ $i -lt $CISCO_IPV6_SPLIT_INC ] ; do
			eval NETWORK="\${CISCO_IPV6_SPLIT_INC_${i}_ADDR}"
			eval NETMASKLEN="\${CISCO_IPV6_SPLIT_INC_${i}_MASKLEN}"
			if [ $NETMASKLEN -eq 0 ]; then
				reset_ipv6_default_route
			else
				del_ipv6_network_route "$NETWORK" "$NETMASKLEN" "$TUNDEV"
			fi
			i=`expr $i + 1`
		done
	elif [ -n "$INTERNAL_IP6_NETMASK" -o -n "$INTERNAL_IP6_ADDRESS" ]; then
		reset_ipv6_default_route
	fi

	del_vpngateway_route

	if [ -n "$INTERNAL_IP4_DNS$INTERNAL_IP6_DNS" ]; then
		$RESTORERESOLVCONF
	fi


	undo_ifconfig
}

do_attempt_reconnect() {
	# The service observes this event; successful reconnect replans atomically.
	:
}

#### Main

if [ -z "$reason" ]; then
	echo "this script must be called from vpnc" 1>&2
	exit 1
fi

case "$reason" in
	pre-init)
		# OpenConnect owns TUN creation; no module loading or device-node writes.
		:
		;;
	connect)
		do_connect
		;;
	disconnect)
		do_disconnect
		;;
	attempt-reconnect)
		# Invoked before each attempt to re-establish the session.
		# If the underlying physical connection changed, we might
		# be left with a route to the VPN server through the VPN
		# itself, which would need to be fixed.
		do_attempt_reconnect
		;;
	reconnect)
		do_connect
		;;
	*)
		echo "unknown reason '$reason'. Maybe vpnc-script is out of date" 1>&2
		exit 1
		;;
esac

exit 0
