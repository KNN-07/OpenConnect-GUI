@@ -688,16 +688,29 @@
 		if (ret)
 			return ret;
 	}
-	if (gen_hotp(vpninfo, vpninfo->token_time, tokencode))
+	if (gen_hotp(vpninfo, vpninfo->token_time, tokencode)) {
+		if (vpninfo->unlock_token)
