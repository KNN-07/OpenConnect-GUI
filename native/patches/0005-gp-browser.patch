+/* Browser negotiation values/placement adapted from the GPL-3.0 project
+ * yuezk/GlobalProtect-openconnect, commit
+ * 9e4f45997ebee452c58d7d3066dcfc175d65ef82, crates/gpapi/src/params/
+ * {portal_prelogin,gateway_prelogin}.rs and os_profile/mod.rs.
+ * No OS identities, compliance data or separate HTTP implementation copied.
+ */
+static void ocgui_gp_enter_phase(struct openconnect_info *vpninfo, int portal)
+{
+	int phase = portal ? 1 : 2;
+	if (vpninfo->ocgui_gp_phase == phase)
+		return;
+	vpninfo->ocgui_gp_phase = phase;
+	vpninfo->ocgui_gp_external_allowed = -1;
+	vpninfo->ocgui_gp_requested_mode = 0;
+	vpninfo->ocgui_gp_retry_used = 0;
+	vpninfo->ocgui_gp_auth_rejected = 0;
+	vpninfo->ocgui_gp_retry_requested = 0;
+	vpninfo->ocgui_gp_retry_eligible = 0;
+}
